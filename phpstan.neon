parameters:
    level: 6
    paths:
        - src
        - public/index.php
    bootstrapFiles:
        - config/config.php
        - includes/bootstrap.php
        - includes/security.php
        - includes/DeviceStatus.php
        - includes/AssetTagGenerator.php
        - includes/WorkstationService.php
    ignoreErrors:
        -
            identifier: missingType.iterableValue
    reportUnmatchedIgnoredErrors: false
