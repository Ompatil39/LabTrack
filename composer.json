{
  "name": "ompatil39/labtrack",
  "description": "LabTrack computer lab monitoring and management system",
  "type": "project",
  "config": {
    "platform-check": false
  },
  "require": {
    "php": ">=8.0",
    "phpmailer/phpmailer": "^6.9",
    "chillerlan/php-qrcode": "^5.0",
    "tecnickcom/tcpdf": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^7.2",
    "monolog/monolog": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "LabTrack\\": [
        "src/",
        "includes/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LabTrack\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.50",
    "symfony/console": "^5.4",
    "symfony/process": "^5.4",
    "symfony/filesystem": "^5.4",
    "symfony/finder": "^5.4",
    "symfony/event-dispatcher": "^5.4",
    "symfony/stopwatch": "^5.4",
    "symfony/options-resolver": "^5.4",
    "symfony/string": "^5.4",
    "psr/log": "^2.0",
    "doctrine/instantiator": "1.5"
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "format": "php-cs-fixer fix",
    "ci": [
      "@lint",
      "@stan",
      "@test"
    ]
  }
}
